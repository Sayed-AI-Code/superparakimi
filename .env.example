# Postgres connection string used by the app.
#
# In DEVELOPMENT this may be left UNSET: the app then boots an in-memory PGlite
# instance so a fresh clone runs without provisioning anything. That instance is
# wiped when the dev server restarts, and it exists only because NODE_ENV says
# development.
#
# Outside development an unset DATABASE_URL is a hard startup error, on purpose:
# an ephemeral database that boots "successfully" in production and loses every
# row on the next cold start is worse than refusing to start. Set this to your
# Neon (or other real Postgres) connection string to deploy.
#
# A `postgres://` URL to a non-Neon host is served by node-postgres over the
# wire protocol; only *.neon.tech uses Neon's HTTP driver. See productionDriver
# in db/index.ts.
DATABASE_URL=postgresql://user:password@localhost:5432/superparakimi

# Secret used to sign the Auth.js session cookie; generate with `openssl rand -base64 32`.
AUTH_SECRET=replace-me-with-a-random-32-byte-secret

# OAuth client id from Google Cloud Console.
AUTH_GOOGLE_ID=replace-me.apps.googleusercontent.com

# OAuth client secret from Google Cloud Console.
AUTH_GOOGLE_SECRET=replace-me-with-google-oauth-client-secret

# API key for OpenRouter, the upstream model provider for paraphrasing.
OPENROUTER_API_KEY=sk-or-replace-me-with-openrouter-key

# Model id sent to OpenRouter for paraphrase requests.
PARAPHRASE_MODEL=openai/gpt-4o-mini

# Postgres connection string used only by the test suites (never the app).
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/superparakimi_test

# Optional: connection-pool size for the node-postgres backend. Defaults to 10.
# The Playwright smoke sets this to 1 itself, because its database is PGlite
# behind a socket and PGlite executes one query at a time — a wider pool resets
# the connection. Do not lower it in production to make a test pass.
# PG_POOL_MAX=10

# Optional: host directory for the DEVELOPMENT-only PGlite instance. Unset means
# in memory, which is the default because PGlite's file-backed VFS does not work
# under Turbopack. Development only; has no effect in production.
# DEV_PGLITE_DIR=
